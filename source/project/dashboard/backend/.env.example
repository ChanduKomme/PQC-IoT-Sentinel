# Copy this to ../../.env or dashboard/backend/.env and edit values.
# The backend first loads project-root .env, then dashboard/backend/.env if present.

SPLUNK_INDEX=pqc_iot
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USER=admin
SPLUNK_PASS=YOUR_SPLUNK_WEB_LOGIN_PASSWORD
SPLUNK_VERIFY_TLS=false

# HEC values are used by boards and connectivity testing. The dashboard reads via 8089.
SPLUNK_HEC_URL=http://localhost:8088
SPLUNK_HEC_TOKEN=YOUR_SPLUNK_HEC_TOKEN
SPLUNK_SOURCETYPE=pqc:iot:event
