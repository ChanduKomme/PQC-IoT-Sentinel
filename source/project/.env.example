# Copy to .env. Values are data; shell commands and substitutions are not executed.
BL60X_SDK_PATH=/absolute/path/to/bl_iot_sdk
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PW=YOUR_WIFI_PASSWORD
MAX_MAKE_JOBS=2
PQC_EXPERIMENT_ID=pqc-lab-001
PQC_ENABLE_OLED=0

# Offline dashboard works with these credentials empty.
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USER=admin
SPLUNK_PASS=
SPLUNK_INDEX=pqc_iot
SPLUNK_VERIFY_TLS=true
SPLUNK_CA_FILE=
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_HEC_TOKEN=

DTLS_SERVER_HOST=auto
DTLS_RECEIVER_PORT=/dev/ttyUSB0
DTLS_SAMPLE_COUNT=300
DTLS_REPEAT_SESSIONS=0
DTLS_INTER_MESSAGE_DELAY_MS=100
SERIAL_BAUDRATE=2000000
